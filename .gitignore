# ===========================================================================
#  运行时数据 / 本机隐私 —— 绝对不要提交
# ===========================================================================

# 项目记忆（含本机账号 uid、昵称、绝对路径等内部记录）
.workbuddy/

# 网关日志
logs/
*.log

# 面板运行时状态（网关 PID）
.runtime.json

# Chrome/Edge --app 应用窗口的 user-data-dir（体积极大，且含浏览数据）
.app-profile/

# 本机绝对路径写死的配置；参考 config.example.json 自己建一份
config-native.json
bin/config.json

# 账号池与网关状态（真实凭据，泄露等于账号被接管）
auths/
data/
*.info

# ===========================================================================
#  构建产物（请在本地构建，或用 GitHub Releases 分发）
# ===========================================================================

# bin/ 里的 4 个网关二进制在本仓库不提供，见 README「构建 bin/」
bin/
build/
dist/
.nativebuild/
__pycache__/
*.pyc
*.spec

# ===========================================================================
#  编辑器 / 操作系统
# ===========================================================================
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
